<!--NOTE: The only WindowStyle allowed for AllowsTransparency=true is "None". Else a crash happens.-->
<Window x:Class="Instrumind.ThinkComposer.ApplicationShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:this="clr-namespace:Instrumind.ThinkComposer.ApplicationShell"
        Title="Instrumind ThinkComposer"
        Background="{DynamicResource TcShellCanvasBrush}"
        Width="1440" Height="810" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        BorderBrush="{DynamicResource TcShellBorderBrush}" BorderThickness="0"
        Icon="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/Instrumind_ThinkComposer.ico"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Closing="Window_Closing" Closed="Window_Closed">
    <!--Standard size: 1600x900 (for screenshots use: 1400x915)
        For YouTube videos use 16x9 aspect ratios: 1920*1080, 1600*900,  1280*720, [1440*810], 1024*576, 800*450, 720*405 (standard Youtube HD) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <this:MainWindowHeader x:Name="WinHeader" Grid.Row="0"
                               VerticalAlignment="Top" HorizontalAlignment="Stretch"
                               Dragging="WinHeader_Dragging" Minimizing="WinHeader_Minimizing"
                               RestoringOrMaximizing="WinHeader_RestoringOrMaximizing"/>

        <Border x:Name="WorkingAreaBorder" Grid.Row="1"
                Background="{DynamicResource TcShellCanvasBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition x:Name="ExplorerColumn" Width="240" MinWidth="0"/>
                    <ColumnDefinition MinWidth="260"/>
                    <ColumnDefinition x:Name="InspectorColumn" Width="250" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="BottomPanelRow" Height="180" MinHeight="0"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="3"
                        Background="{DynamicResource TcShellRailBrush}"
                        BorderBrush="{DynamicResource TcShellBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6">
                        <Button Style="{StaticResource TcShellRailButtonStyle}"
                                ToolTip="Explorer"
                                AutomationProperties.Name="Toggle Explorer"
                                Click="ToggleExplorerPanel_Click">
                            <Image Source="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/book_tabs.png"
                                   Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TcShellRailButtonStyle}"
                                ToolTip="Inspector"
                                AutomationProperties.Name="Toggle Inspector"
                                Click="ToggleInspectorPanel_Click">
                            <Image Source="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/vcard_edit.png"
                                   Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TcShellRailButtonStyle}"
                                ToolTip="Messages"
                                AutomationProperties.Name="Toggle Messages"
                                Click="ToggleBottomPanel_Click">
                            <Image Source="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/comment.png"
                                   Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TcShellRailButtonStyle}"
                                ToolTip="Focus canvas"
                                AutomationProperties.Name="Focus Canvas"
                                Click="ToggleFocusMode_Click">
                            <Image Source="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/zoom.png"
                                   Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TcShellRailButtonStyle}"
                                ToolTip="Toggle light/dark theme"
                                AutomationProperties.Name="Toggle Theme"
                                Click="ToggleShellTheme_Click">
                            <Image Source="/Instrumind.ThinkComposer;component/ApplicationProduct/Images/color_swatch.png"
                                   Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="ExplorerPanel" Grid.Column="1" Grid.Row="0"
                        Background="{DynamicResource TcShellPanelBrush}"
                        BorderBrush="{DynamicResource TcShellBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="32"
                                BorderBrush="{DynamicResource TcShellBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True" Margin="10,0,6,0">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource TcShellPanelCollapseButtonStyle}"
                                        ToolTip="Collapse Explorer"
                                        AutomationProperties.Name="Collapse Explorer"
                                        Click="ToggleExplorerPanel_Click">
                                    <TextBlock Text="&lt;" FontWeight="SemiBold"/>
                                </Button>
                                <TextBlock Text="EXPLORER" Style="{StaticResource TcShellPanelTitleStyle}"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.5*" MinHeight="20"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="0.5*" MinHeight="20"/>
                            </Grid.RowDefinitions>
                            <DockPanel x:Name="NavigationTopContainer" Grid.Row="0" Margin="0"/>
                            <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="3"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource TcShellBorderBrush}"/>
                            <DockPanel x:Name="NavigationBottomContainer" Grid.Row="2" Margin="0"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="0"
                        Background="{DynamicResource TcShellCanvasBrush}">
                    <DockPanel x:Name="DocumentContainer" Margin="0"/>
                </Border>

                <Border x:Name="InspectorPanel" Grid.Column="3" Grid.Row="0"
                        Background="{DynamicResource TcShellPanelBrush}"
                        BorderBrush="{DynamicResource TcShellBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="32"
                                BorderBrush="{DynamicResource TcShellBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True" Margin="10,0,6,0">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource TcShellPanelCollapseButtonStyle}"
                                        ToolTip="Collapse Inspector"
                                        AutomationProperties.Name="Collapse Inspector"
                                        Click="ToggleInspectorPanel_Click">
                                    <TextBlock Text="&gt;" FontWeight="SemiBold"/>
                                </Button>
                                <TextBlock Text="INSPECTOR" Style="{StaticResource TcShellPanelTitleStyle}"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.58*" MinHeight="20"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="0.22*" MinHeight="20"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="0.2*" MinHeight="20"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="124" MinHeight="20"/>
                            </Grid.RowDefinitions>
                            <DockPanel x:Name="EditingTopContainer" Grid.Row="0" Margin="0"/>
                            <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="3"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource TcShellBorderBrush}"/>
                            <DockPanel x:Name="EditingMediumUpperContainer" Grid.Row="2" Margin="0"/>
                            <GridSplitter Grid.Row="3" ResizeDirection="Rows" Height="3"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource TcShellBorderBrush}"/>
                            <DockPanel x:Name="EditingMediumLowerContainer" Grid.Row="4" Margin="0"/>
                            <GridSplitter Grid.Row="5" ResizeDirection="Rows" Height="3"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{DynamicResource TcShellBorderBrush}"/>
                            <DockPanel x:Name="EditingBottomContainer" Grid.Row="6" Margin="0"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border x:Name="BottomPanel" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                        Background="{DynamicResource TcShellBottomBrush}"
                        BorderBrush="{DynamicResource TcShellBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="32"
                                BorderBrush="{DynamicResource TcShellBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True" Margin="10,0,6,0">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource TcShellPanelCollapseButtonStyle}"
                                        ToolTip="Collapse Messages"
                                        AutomationProperties.Name="Collapse Messages"
                                        Click="ToggleBottomPanel_Click">
                                    <TextBlock Text="v" FontWeight="SemiBold"/>
                                </Button>
                                <TextBlock Text="MESSAGES / SEARCH / PREVIEW" Style="{StaticResource TcShellPanelTitleStyle}"/>
                            </DockPanel>
                        </Border>
                        <DockPanel x:Name="MessagingContainer" Margin="0"/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2"
                        Background="{DynamicResource TcShellAccentBrush}">
                    <DockPanel LastChildFill="True">
                        <DockPanel x:Name="StatusContainer" DockPanel.Dock="Right" MinWidth="260"/>
                        <TextBlock Text="Ready"
                                   Foreground="{DynamicResource TcShellAccentTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
