<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Instrumind.ThinkComposer.WinUI.Canvas.CompositionCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <win2d:CanvasControl
            x:Name="DrawingSurface"
            ClearColor="Transparent"
            Draw="DrawingSurface_Draw"
            PointerMoved="DrawingSurface_PointerMoved"
            PointerPressed="DrawingSurface_PointerPressed"
            PointerReleased="DrawingSurface_PointerReleased"
            PointerWheelChanged="DrawingSurface_PointerWheelChanged" />
    </Grid>
</UserControl>
