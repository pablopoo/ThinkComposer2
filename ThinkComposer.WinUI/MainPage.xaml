<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Instrumind.ThinkComposer.WinUI.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Instrumind.ThinkComposer.WinUI.Canvas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Light"
    Background="{ThemeResource AppBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource ChromeForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ChromeForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="BottomTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource ChromeForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Up" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Down" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Control" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Control" Invoked="MoveSelectionKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootLayout" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="10,0" Background="{ThemeResource TitleBarBackgroundBrush}" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar
                Grid.Column="0"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                Foreground="{ThemeResource ChromeForegroundBrush}"
                IsOpen="False">
                <AppBarButton Click="NewDocumentButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Document" Label="New" ToolTipService.ToolTip="New document" />
                <AppBarButton Click="NewConceptButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Add" Label="New concept" ToolTipService.ToolTip="New concept" />
                <AppBarButton Click="NewRelationshipButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Link" Label="Link" ToolTipService.ToolTip="Create relationship from selected concept" />
                <AppBarButton Click="OpenButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open .tcdoc, .tcview, or legacy package" />
                <AppBarButton x:Name="RecentButton" Click="RecentButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="OpenFile" Label="Recent" ToolTipService.ToolTip="Open recent document" />
                <AppBarButton Click="MergeButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Import" Label="Merge" ToolTipService.ToolTip="Merge another document into this one" />
                <AppBarButton Click="SaveButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Save" Label="Save" ToolTipService.ToolTip="Save" />
                <AppBarButton Click="SaveAsButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="SaveLocal" Label="Save As" ToolTipService.ToolTip="Save as .tcdoc or .tcview" />
                <AppBarButton Click="ExportButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="SaveLocal" Label="Export" ToolTipService.ToolTip="Export HTML or SVG" />
                <AppBarButton Click="ReportButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Document" Label="Report" ToolTipService.ToolTip="Export document report" />
                <AppBarButton Click="GenerateFilesButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Setting" Label="Generate" ToolTipService.ToolTip="Generate files from templates" />
                <AppBarButton Click="PrintPreviewButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Print" Label="Print" ToolTipService.ToolTip="Open printable preview" />
                <AppBarSeparator />
                <AppBarButton Click="UndoButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Undo" Label="Undo" ToolTipService.ToolTip="Undo" />
                <AppBarButton Click="RedoButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Redo" Label="Redo" ToolTipService.ToolTip="Redo" />
                <AppBarSeparator />
                <AppBarButton Click="DeleteButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Delete" Label="Delete" ToolTipService.ToolTip="Delete selected concept" />
                <AppBarButton Click="CutButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Cut" Label="Cut" ToolTipService.ToolTip="Cut selected concepts" />
                <AppBarButton Click="CopyButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Copy" Label="Copy" ToolTipService.ToolTip="Copy selected concepts" />
                <AppBarButton Click="PasteButton_Click" Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Paste" Label="Paste" ToolTipService.ToolTip="Paste concepts" />
            </CommandBar>

            <AutoSuggestBox
                x:Name="CommandSearchBox"
                Grid.Column="1"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Title"
                QuerySubmitted="CommandSearchBox_QuerySubmitted"
                SuggestionChosen="CommandSearchBox_SuggestionChosen"
                TextChanged="CommandSearchBox_TextChanged"
                PlaceholderText="Find command, object, view..." />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button
                    Click="FocusButton_Click"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTipService.ToolTip="Focus canvas">
                    <SymbolIcon Symbol="FullScreen" />
                </Button>
                <Button
                    Click="ThemeButton_Click"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTipService.ToolTip="Toggle theme">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomRow" Height="148" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="0"
                Padding="8,8"
                Background="{ThemeResource RailBackgroundBrush}"
                Spacing="8">
                <Button Click="ExplorerButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Explorer">
                    <SymbolIcon Symbol="Folder" />
                </Button>
                <Button Click="InspectorButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Inspector">
                    <SymbolIcon Symbol="Setting" />
                </Button>
                <Button Click="BottomButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Messages">
                    <SymbolIcon Symbol="Message" />
                </Button>
                <Button Click="SearchRailButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Search">
                    <SymbolIcon Symbol="Find" />
                </Button>
            </StackPanel>

            <Border
                x:Name="ExplorerPanel"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="EXPLORER" />
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="ExplorerButton_Click"
                            Content="&lt;"
                            ToolTipService.ToolTip="Collapse explorer" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SelectedTabBackgroundBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Content" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Text="Domain" />
                    </Grid>
                    <TreeView
                        x:Name="ExplorerTree"
                        Grid.Row="2"
                        Margin="8,10,8,8"
                        SelectionChanged="ExplorerTree_SelectionChanged">
                        <TreeView.RootNodes>
                            <TreeViewNode Content="Composition 1" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Customer Journey" />
                                    <TreeViewNode Content="Capabilities" />
                                    <TreeViewNode Content="System Map" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Interpretations" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Pointed by..." />
                                    <TreeViewNode Content="Pointing to..." />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                        </TreeView.RootNodes>
                    </TreeView>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Padding="10,0,0,0"
                    Background="{ThemeResource PanelBackgroundBrush}"
                    BorderBrush="{ThemeResource ShellBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Border
                        Width="148"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0">
                        <TextBlock x:Name="CompositionTitleText" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Composition 1" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Background="{ThemeResource CanvasBackgroundBrush}">
                    <canvas:CompositionCanvas x:Name="CanvasView" />
                </Grid>
            </Grid>

            <Border
                x:Name="InspectorPanel"
                Grid.RowSpan="2"
                Grid.Column="3"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="INSPECTOR" />
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="InspectorButton_Click"
                            Content="&gt;"
                            ToolTipService.ToolTip="Collapse inspector" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SelectedTabBackgroundBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Object" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Text="Style" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,10,12,12" Spacing="10">
                            <Expander x:Name="ObjectExpander" Header="Concept" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Name" />
                                    <TextBox
                                        x:Name="InspectorNameBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        KeyDown="InspectorNameBox_KeyDown"
                                        LostFocus="InspectorNameBox_LostFocus"
                                        Text="Customer Need" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Kind" />
                                    <ComboBox
                                        x:Name="InspectorKindBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        SelectionChanged="InspectorKindBox_SelectionChanged"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Concept" />
                                        <ComboBoxItem Content="Role" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Status" />
                                    <ComboBox
                                        x:Name="InspectorStatusBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Draft" />
                                        <ComboBoxItem Content="Reviewed" />
                                    </ComboBox>
                                </Grid>
                            </Expander>

                            <Expander Header="Layout" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="X" />
                                    <NumberBox
                                        x:Name="InspectorXBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="InspectorLayoutBox_ValueChanged"
                                        Value="120" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Y" />
                                    <NumberBox
                                        x:Name="InspectorYBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="InspectorLayoutBox_ValueChanged"
                                        Value="132" />

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Width" />
                                    <NumberBox
                                        x:Name="InspectorWidthBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="InspectorLayoutBox_ValueChanged"
                                        Value="164" />

                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Height" />
                                    <NumberBox
                                        x:Name="InspectorHeightBox"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="InspectorLayoutBox_ValueChanged"
                                        Value="82" />
                                </Grid>
                            </Expander>

                            <Expander x:Name="DetailsExpander" Header="Details" IsExpanded="True">
                                <StackPanel Padding="0,10,0,0" Spacing="8">
                                    <ListView
                                        x:Name="InspectorDetailsList"
                                        MaxHeight="118"
                                        SelectionChanged="InspectorDetailsList_SelectionChanged"
                                        SelectionMode="Single" />
                                    <TextBox x:Name="DetailNameBox" PlaceholderText="Detail name" />
                                    <TextBox x:Name="DetailValueBox" PlaceholderText="Value" />
                                    <TextBox x:Name="DetailKindBox" PlaceholderText="Kind" Text="CustomField" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="UpsertDetailButton"
                                            HorizontalAlignment="Stretch"
                                            Click="UpsertDetailButton_Click"
                                            Content="Save detail" />
                                        <Button
                                            x:Name="DeleteDetailButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Click="DeleteDetailButton_Click"
                                            Content="Remove" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="MarkersExpander" Header="Markers" IsExpanded="False">
                                <StackPanel Padding="0,10,0,0" Spacing="8">
                                    <TextBox
                                        x:Name="MarkerIdsBox"
                                        AcceptsReturn="True"
                                        MinHeight="64"
                                        TextWrapping="Wrap"
                                        PlaceholderText="Marker ids, separated by commas" />
                                    <Button
                                        x:Name="ApplyMarkersButton"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplyMarkersButton_Click"
                                        Content="Apply markers" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="TemplateExpander" Header="Generation template" IsExpanded="False">
                                <StackPanel Padding="0,10,0,0" Spacing="8">
                                    <TextBox x:Name="TemplateKeyBox" PlaceholderText="template.concept.name" />
                                    <TextBox
                                        x:Name="TemplateValueBox"
                                        AcceptsReturn="True"
                                        MinHeight="120"
                                        TextWrapping="Wrap"
                                        PlaceholderText="%%:FILENAME={{Name}}.md&#x0a;# {{Name}}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="UpsertTemplateButton"
                                            HorizontalAlignment="Stretch"
                                            Click="UpsertTemplateButton_Click"
                                            Content="Save template" />
                                        <Button
                                            x:Name="DeleteTemplateButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Click="DeleteTemplateButton_Click"
                                            Content="Remove" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="StyleExpander" Header="Style" IsExpanded="False">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Fill" />
                                    <TextBox x:Name="InspectorFillBox" Grid.Column="1" PlaceholderText="#ffffff" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Stroke" />
                                    <TextBox x:Name="InspectorStrokeBox" Grid.Row="1" Grid.Column="1" PlaceholderText="#8a9ba8" />

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Text" />
                                    <TextBox x:Name="InspectorTextColorBox" Grid.Row="2" Grid.Column="1" PlaceholderText="#1f1f1f" />

                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Line" />
                                    <NumberBox x:Name="InspectorStrokeThicknessBox" Grid.Row="3" Grid.Column="1" Minimum="0" SmallChange="0.5" SpinButtonPlacementMode="Compact" />

                                    <Button
                                        x:Name="ApplyStyleButton"
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Stretch"
                                        Click="ApplyStyleButton_Click"
                                        Content="Apply style" />
                                </Grid>
                            </Expander>

                            <Expander Header="Relationships" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Name="OutgoingLabel"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource MutedForegroundBrush}"
                                        Text="Outgoing" />
                                    <TextBlock x:Name="OutgoingText" Grid.Column="1" VerticalAlignment="Center" Text="1" />

                                    <TextBlock
                                        x:Name="IncomingLabel"
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource MutedForegroundBrush}"
                                        Text="Incoming" />
                                    <TextBlock x:Name="IncomingText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="0" />
                                </Grid>
                            </Expander>

                            <Expander Header="Actions" IsExpanded="True">
                                <StackPanel Padding="0,10,0,0" Spacing="8">
                                    <Button
                                        x:Name="InspectorRelationshipButton"
                                        HorizontalAlignment="Stretch"
                                        Click="NewRelationshipButton_Click"
                                        Content="Create relationship from selection" />
                                    <Button
                                        x:Name="InspectorDeleteButton"
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteButton_Click"
                                        Content="Delete selection" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="BottomPanel"
                Grid.Row="1"
                Grid.Column="2"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button
                                x:Name="MessagesTabButton"
                                Click="MessagesTabButton_Click"
                                Content="Messages"
                                FontWeight="SemiBold"
                                Style="{StaticResource BottomTabButtonStyle}" />
                            <Button
                                x:Name="SearchTabButton"
                                Click="SearchTabButton_Click"
                                Content="Search"
                                Opacity="0.72"
                                Style="{StaticResource BottomTabButtonStyle}" />
                            <Button
                                x:Name="PreviewTabButton"
                                Click="PreviewTabButton_Click"
                                Content="Preview"
                                Opacity="0.72"
                                Style="{StaticResource BottomTabButtonStyle}" />
                            <Button
                                x:Name="DiagnosticsTabButton"
                                Click="DiagnosticsTabButton_Click"
                                Content="Diagnostics"
                                Opacity="0.72"
                                Style="{StaticResource BottomTabButtonStyle}" />
                        </StackPanel>
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="BottomButton_Click"
                            Content="v"
                            ToolTipService.ToolTip="Collapse bottom panel" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="MessagesPanelContent" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="MessagesText"
                                Padding="12,8"
                                FontFamily="Consolas"
                                FontSize="12"
                                Text="ThinkComposer WinUI shell loaded&#x0a;Canvas renderer: Core snapshot DTOs&#x0a;Document compatibility: read-only migration path" />
                        </ScrollViewer>

                        <Grid
                            x:Name="SearchPanelContent"
                            Padding="12,8"
                            RowSpacing="8"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="BottomSearchBox"
                                TextChanged="BottomSearchBox_TextChanged"
                                PlaceholderText="Search commands, concepts, relationships..." />
                            <ListView
                                x:Name="SearchResultsList"
                                Grid.Row="1"
                                DisplayMemberPath="Title"
                                SelectionChanged="SearchResultsList_SelectionChanged" />
                        </Grid>

                        <ScrollViewer
                            x:Name="PreviewPanelContent"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PreviewText"
                                Padding="12,8"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <ScrollViewer
                            x:Name="DiagnosticsPanelContent"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="DiagnosticsText"
                                Padding="12,8"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="10,0" Background="{ThemeResource StatusBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="Ready" />
            <TextBlock x:Name="StatusContextText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="WinUI migration shell" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="Native app" />
        </Grid>
    </Grid>
</Page>
