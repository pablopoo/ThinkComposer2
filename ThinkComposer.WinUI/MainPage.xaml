<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Instrumind.ThinkComposer.WinUI.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Instrumind.ThinkComposer.WinUI.Canvas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Light"
    Background="{ThemeResource AppBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource ChromeForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ChromeForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayout" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="10,0" Background="{ThemeResource TitleBarBackgroundBrush}" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar
                Grid.Column="0"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                Foreground="{ThemeResource ChromeForegroundBrush}"
                IsOpen="False">
                <AppBarButton Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Add" Label="New" ToolTipService.ToolTip="New composition" />
                <AppBarButton Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Save" Label="Save" ToolTipService.ToolTip="Save" />
                <AppBarSeparator />
                <AppBarButton Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Undo" Label="Undo" ToolTipService.ToolTip="Undo" />
                <AppBarButton Foreground="{ThemeResource ChromeForegroundBrush}" Icon="Redo" Label="Redo" ToolTipService.ToolTip="Redo" />
            </CommandBar>

            <AutoSuggestBox
                Grid.Column="1"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                PlaceholderText="Find command, object, view..." />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button
                    Click="FocusButton_Click"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTipService.ToolTip="Focus canvas">
                    <SymbolIcon Symbol="FullScreen" />
                </Button>
                <Button
                    Click="ThemeButton_Click"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTipService.ToolTip="Toggle theme">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomRow" Height="148" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="0"
                Padding="8,8"
                Background="{ThemeResource RailBackgroundBrush}"
                Spacing="8">
                <Button Click="ExplorerButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Explorer">
                    <SymbolIcon Symbol="Folder" />
                </Button>
                <Button Click="InspectorButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Inspector">
                    <SymbolIcon Symbol="Setting" />
                </Button>
                <Button Click="BottomButton_Click" Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Messages">
                    <SymbolIcon Symbol="Message" />
                </Button>
                <Button Style="{StaticResource RailButtonStyle}" ToolTipService.ToolTip="Search">
                    <SymbolIcon Symbol="Find" />
                </Button>
            </StackPanel>

            <Border
                x:Name="ExplorerPanel"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="EXPLORER" />
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="ExplorerButton_Click"
                            Content="&lt;"
                            ToolTipService.ToolTip="Collapse explorer" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SelectedTabBackgroundBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Content" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Text="Domain" />
                    </Grid>
                    <TreeView Grid.Row="2" Margin="8,10,8,8">
                        <TreeView.RootNodes>
                            <TreeViewNode Content="Composition 1" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Customer Journey" />
                                    <TreeViewNode Content="Capabilities" />
                                    <TreeViewNode Content="System Map" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Interpretations" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Pointed by..." />
                                    <TreeViewNode Content="Pointing to..." />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                        </TreeView.RootNodes>
                    </TreeView>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Padding="10,0,0,0"
                    Background="{ThemeResource PanelBackgroundBrush}"
                    BorderBrush="{ThemeResource ShellBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Border
                        Width="148"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0">
                        <TextBlock x:Name="CompositionTitleText" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Composition 1" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Background="{ThemeResource CanvasBackgroundBrush}">
                    <canvas:CompositionCanvas x:Name="CanvasView" />
                </Grid>
            </Grid>

            <Border
                x:Name="InspectorPanel"
                Grid.RowSpan="2"
                Grid.Column="3"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="INSPECTOR" />
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="InspectorButton_Click"
                            Content="&gt;"
                            ToolTipService.ToolTip="Collapse inspector" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SelectedTabBackgroundBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,1,0">
                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Object" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Text="Style" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,10,12,12" Spacing="10">
                            <Expander Header="Concept" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Name" />
                                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="Customer Need" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Kind" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Concept" />
                                        <ComboBoxItem Content="Role" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Status" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Draft" />
                                        <ComboBoxItem Content="Reviewed" />
                                    </ComboBox>
                                </Grid>
                            </Expander>

                            <Expander Header="Layout" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="X" />
                                    <NumberBox Grid.Column="1" HorizontalAlignment="Stretch" SpinButtonPlacementMode="Compact" Value="120" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Y" />
                                    <NumberBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SpinButtonPlacementMode="Compact" Value="132" />

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Width" />
                                    <NumberBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SpinButtonPlacementMode="Compact" Value="164" />

                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Height" />
                                    <NumberBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SpinButtonPlacementMode="Compact" Value="82" />
                                </Grid>
                            </Expander>

                            <Expander Header="Relationships" IsExpanded="True">
                                <Grid Padding="0,10,0,0" ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Outgoing" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="1" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedForegroundBrush}" Text="Incoming" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="0" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="BottomPanel"
                Grid.Row="1"
                Grid.Column="2"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ShellBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Messages" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource MutedForegroundBrush}" Text="Search" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource MutedForegroundBrush}" Text="Preview" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource MutedForegroundBrush}" Text="Diagnostics" />
                        </StackPanel>
                        <Button
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="BottomButton_Click"
                            Content="v"
                            ToolTipService.ToolTip="Collapse bottom panel" />
                    </Grid>
                    <TextBlock
                        x:Name="MessagesText"
                        Grid.Row="1"
                        Padding="12,8"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="ThinkComposer WinUI shell loaded&#x0a;Canvas renderer: Core snapshot DTOs&#x0a;Document compatibility: read-only migration path" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="10,0" Background="{ThemeResource StatusBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="Ready" />
            <TextBlock x:Name="StatusContextText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="WinUI migration shell" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource StatusForegroundBrush}" Text="Native app" />
        </Grid>
    </Grid>
</Page>
