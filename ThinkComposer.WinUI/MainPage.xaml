<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Instrumind.ThinkComposer.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="10,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar
                Grid.Column="0"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsOpen="False">
                <AppBarButton Icon="Add" Label="New" ToolTipService.ToolTip="New composition" />
                <AppBarButton Icon="Save" Label="Save" ToolTipService.ToolTip="Save" />
                <AppBarSeparator />
                <AppBarButton Icon="Undo" Label="Undo" ToolTipService.ToolTip="Undo" />
                <AppBarButton Icon="Redo" Label="Redo" ToolTipService.ToolTip="Redo" />
            </CommandBar>

            <AutoSuggestBox
                Grid.Column="1"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                PlaceholderText="Find command, object, view..." />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button
                    Width="34"
                    Height="32"
                    Click="FocusButton_Click"
                    ToolTipService.ToolTip="Focus canvas">
                    <SymbolIcon Symbol="FullScreen" />
                </Button>
                <Button
                    Width="34"
                    Height="32"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Toggle theme">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="286" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomRow" Height="148" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="0"
                Padding="6,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Spacing="8">
                <Button Width="36" Height="36" Click="ExplorerButton_Click" ToolTipService.ToolTip="Explorer">
                    <SymbolIcon Symbol="Folder" />
                </Button>
                <Button Width="36" Height="36" Click="InspectorButton_Click" ToolTipService.ToolTip="Inspector">
                    <SymbolIcon Symbol="Setting" />
                </Button>
                <Button Width="36" Height="36" Click="BottomButton_Click" ToolTipService.ToolTip="Messages">
                    <SymbolIcon Symbol="Message" />
                </Button>
                <Button Width="36" Height="36" ToolTipService.ToolTip="Search">
                    <SymbolIcon Symbol="Find" />
                </Button>
            </StackPanel>

            <Border
                x:Name="ExplorerPanel"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="EXPLORER" />
                        <Button
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Click="ExplorerButton_Click"
                            Content="&lt;"
                            ToolTipService.ToolTip="Collapse explorer" />
                    </Grid>
                    <TabView
                        Grid.Row="1"
                        Height="44"
                        CanDragTabs="False"
                        CanReorderTabs="False"
                        IsAddTabButtonVisible="False">
                        <TabViewItem Header="Content" IsClosable="False" />
                        <TabViewItem Header="Domain" IsClosable="False" />
                    </TabView>
                    <TreeView Grid.Row="2" Margin="8">
                        <TreeView.RootNodes>
                            <TreeViewNode Content="Composition 1" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Customer Journey" />
                                    <TreeViewNode Content="Capabilities" />
                                    <TreeViewNode Content="System Map" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Interpretations" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Pointed by..." />
                                    <TreeViewNode Content="Pointing to..." />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                        </TreeView.RootNodes>
                    </TreeView>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Padding="10,0,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Border
                        Width="148"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0">
                        <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Composition 1" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Canvas>
                        <Border
                            Canvas.Left="18"
                            Canvas.Top="18"
                            Padding="6"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <CommandBar Background="Transparent" DefaultLabelPosition="Collapsed">
                                <AppBarButton Icon="Edit" Label="Pointer" />
                                <AppBarButton Icon="Add" Label="Concept" />
                                <AppBarButton Icon="Link" Label="Relationship" />
                            </CommandBar>
                        </Border>

                        <Line
                            X1="230"
                            Y1="172"
                            X2="460"
                            Y2="218"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2" />
                        <Line
                            X1="458"
                            Y1="220"
                            X2="700"
                            Y2="146"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2" />

                        <Border
                            Canvas.Left="120"
                            Canvas.Top="132"
                            Width="164"
                            Padding="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Customer Need" />
                                <TextBlock FontSize="12" Text="Selected concept" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Canvas.Left="420"
                            Canvas.Top="190"
                            Width="174"
                            Padding="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Business Capability" />
                                <TextBlock FontSize="12" Text="Native WinUI shell placeholder" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Canvas.Left="690"
                            Canvas.Top="104"
                            Width="162"
                            Padding="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="System Service" />
                                <TextBlock FontSize="12" Text="Win2D spike comes next" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>

            <Border
                x:Name="InspectorPanel"
                Grid.RowSpan="2"
                Grid.Column="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="INSPECTOR" />
                        <Button
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Click="InspectorButton_Click"
                            Content="&gt;"
                            ToolTipService.ToolTip="Collapse inspector" />
                    </Grid>
                    <TabView
                        Grid.Row="1"
                        Height="44"
                        CanDragTabs="False"
                        CanReorderTabs="False"
                        IsAddTabButtonVisible="False">
                        <TabViewItem Header="Object" IsClosable="False" />
                        <TabViewItem Header="Style" IsClosable="False" />
                    </TabView>
                    <StackPanel Grid.Row="2" Padding="12" Spacing="10">
                        <Expander Header="Concept" IsExpanded="True">
                            <StackPanel Spacing="8">
                                <TextBox Header="Name" Text="Customer Need" />
                                <ComboBox Header="Kind" SelectedIndex="0">
                                    <ComboBoxItem Content="Concept" />
                                    <ComboBoxItem Content="Role" />
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Layout" IsExpanded="True">
                            <StackPanel Spacing="8">
                                <NumberBox Header="X" Value="120" />
                                <NumberBox Header="Y" Value="132" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Relationships">
                            <TextBlock Text="Outgoing: 1&#x0a;Incoming: 0" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="BottomPanel"
                Grid.Row="1"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Messages" />
                            <TextBlock VerticalAlignment="Center" Text="Search" />
                            <TextBlock VerticalAlignment="Center" Text="Preview" />
                            <TextBlock VerticalAlignment="Center" Text="Diagnostics" />
                        </StackPanel>
                        <Button
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            Click="BottomButton_Click"
                            Content="v"
                            ToolTipService.ToolTip="Collapse bottom panel" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Padding="12,8"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="ThinkComposer WinUI shell loaded&#x0a;Canvas renderer: placeholder, Win2D next&#x0a;Document compatibility: baseline inventory ready" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="10,0" Background="{ThemeResource AccentFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="Ready" />
            <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Foreground="White" Text="WinUI migration shell" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="White" Text="Native app" />
        </Grid>
    </Grid>
</Page>
